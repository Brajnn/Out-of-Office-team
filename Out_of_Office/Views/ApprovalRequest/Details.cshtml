@model Out_of_Office.Application.Approval_Request.ApprovalRequestDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Details"];
}

<h2>@Localizer["Approval Request Details"]</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Localizer["TableHeader_ID"]</dt>
        <dd class="col-sm-10">@Model.ID</dd>

        <dt class="col-sm-2">@Localizer["TableHeader_Employee"]</dt>
        <dd class="col-sm-10">@Model.EmployeeFullName</dd>

        <dt class="col-sm-2">@Localizer["TableHeader_Approver"]</dt>
        <dd class="col-sm-10">@Model.ApproverFullName</dd>

        <dt class="col-sm-2">@Localizer["TableHeader_LeaveRequestNumber"]</dt>
        <dd class="col-sm-10">@Model.LeaveRequestID</dd>

        <dt class="col-sm-2">@Localizer["TableHeader_Status"]</dt>
        <dd class="col-sm-10">@Localizer[$"Status{Model.Status}"]</dd>

        @if (Model.LeaveRequestSubmittedAt != null)
        {
            <dt class="col-sm-2">@Localizer["TableHeader_ReceivedDate"]</dt>
            <dd class="col-sm-10">@Model.LeaveRequestSubmittedAt.Value.ToString("dd MMM yyyy HH:mm")</dd>
        }

        <dt class="col-sm-2">@Localizer["StatusChangedAt"]</dt>
        <dd class="col-sm-10">
            @(Model.StatusChangedAt.HasValue
                        ? Model.StatusChangedAt.Value.ToString("yyyy-MM-dd HH:mm")
                        : Localizer["NotYetChanged"])
        </dd>

        <dt class="col-sm-2">@Localizer["LeaveRequestComment"]</dt>
        <dd class="col-sm-10">@Model.LeaveRequestComment</dd>

        <dt class="col-sm-2">@Localizer["DecisionComment"]</dt>
        <dd class="col-sm-10">@Model.DecisionComment</dd>

        <dt class="col-sm-2">@Localizer["LeaveStart"]</dt>
        <dd class="col-sm-10">@Model.StartDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">@Localizer["LeaveEnd"]</dt>
        <dd class="col-sm-10">@Model.EndDate.ToString("yyyy-MM-dd")</dd>
    </dl>
</div>

<p>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["BackToList"]</a>
</p>
