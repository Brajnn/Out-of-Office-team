@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Localization
@using System.Globalization

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Out of Office</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Out_of_Office.styles.css" asp-append-version="true" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["AppName"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Employee") || User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="LeaveRequest" asp-action="Index">@Localizer["LeaveRequests"]</a>
                                </li>
                            }

                            if (User.IsInRole("Employee") || User.IsInRole("HRManager") || User.IsInRole("ProjectManager") || User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Project" asp-action="Index">@Localizer["Projects"]</a>
                                </li>
                            }

                            if (User.IsInRole("HRManager") || User.IsInRole("ProjectManager") || User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Employee" asp-action="Index">@Localizer["Employees"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="ApprovalRequest" asp-action="Index">@Localizer["ApprovalRequests"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="WorkCalendar" asp-action="Index">@Localizer["Calendar"]</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark d-flex align-items-center gap-1"
                               href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @{
                                    var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                                }
                                @if (currentLang == "en")
                                {
                                    <text><img src="~/images/flags/en.png" alt="English" width="20" height="14" class="me-1" /> EN</text>
                                }
                                else if (currentLang == "pl")
                                {
                                    <text><img src="~/images/flags/pl.png" alt="Polski" width="20" height="14" class="me-1" /> PL</text>
                                }
                                else if (currentLang == "de")
                                {
                                    <text><img src="~/images/flags/de.png" alt="Deutsch" width="20" height="14" class="me-1" /> DE</text>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
                                <li>
                                    <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                        <input type="hidden" name="culture" value="en" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-link dropdown-item">
                                            <img src="~/images/flags/en.png" alt="English" width="20" height="14" />
                                            English
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                        <input type="hidden" name="culture" value="pl" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-link dropdown-item">
                                            <img src="~/images/flags/pl.png" alt="Polski" width="20" height="14" />
                                            Polski
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                        <input type="hidden" name="culture" value="de" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-link dropdown-item">
                                            <img src="~/images/flags/de.png" alt="Deutsch" width="20" height="14" />
                                            Deutsch
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localizer["MyProfile"]
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                    <li><a class="dropdown-item" asp-controller="Employee" asp-action="EmployeeProfile">@Localizer["ViewProfile"]</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-item p-0">
                                            <button type="submit" class="btn btn-link dropdown-item">>@Localizer["Logout"]</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">@Localizer["Login"]</a>
                            </li>
                        }
                    </ul>
                    
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Out_of_Office - <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
