@model X.PagedList.IPagedList<Out_of_Office.Application.Employee.EmployeeDto>
@using X.PagedList.Mvc.Core
@using X.PagedList.Mvc.Core.Fluent
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<h2>@Localizer["Employees"]</h2>

<p>
    @using (Html.BeginForm("Index", "Employee", FormMethod.Get))
    {
        <div class="row mb-2">
            <div class="col-md-3">
                <label for="searchString">@Localizer["SearchByName"]</label>
                <input type="text" name="searchString" id="searchString" value="@ViewBag.CurrentFilter" class="form-control" />
            </div>

            <div class="col-md-6">
                <label>@Localizer["FilterByPosition"]</label>
                @foreach (var item in (List<SelectListItem>)ViewBag.Positions)
                {
                    <div class="form-check">
                        <input type="checkbox" name="selectedPositions" value="@item.Value"
                               @(ViewBag.SelectedPositions != null && ((List<string>)ViewBag.SelectedPositions).Contains(item.Value) ? "checked" : "")
                               class="form-check-input" id="position_@item.Value" />
                        <label class="form-check-label" for="position_@item.Value">@Localizer[$"Position_{item.Value}"]</label>
                    </div>
                }
            </div>

            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input type="checkbox" class="form-check-input" id="showInactive" name="showInactive" value="true" @(ViewBag.ShowInactive ? "checked" : "") />
                    <label class="form-check-label" for="showInactive">@Localizer["ShowInactiveEmployees"]</label>
                </div>
            </div>

            <div class="col-md-12 mt-3">
                <button type="submit" class="btn btn-primary">@Localizer["ApplyFilters"]</button>
            </div>
        </div>
    }
</p>
@if (User.IsInRole("Administrator"))
{
    <p>
        @Html.ActionLink(Localizer["AddNewEmployee"].Value, "Create", "Employee", null, new { @class = "btn btn-primary" })
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.ActionLink(Localizer["FullName"].Value, "Index", new { sortOrder = ViewBag.NameSortParm, searchString = ViewBag.CurrentFilter })
            </th>
            <th>
                @Html.ActionLink(Localizer["Position"].Value, "Index", new { sortOrder = ViewBag.PositionSortParm, searchString = ViewBag.CurrentFilter })
            </th>
            <th>@Localizer["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.FullName</td>
                <td>@Localizer[$"Position_{employee.Position}"]</td>
                <td>
                    @if (User.IsInRole("HRManager") || User.IsInRole("Administrator"))
                    {
                        <form asp-action="UpdateStatus" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@employee.Id" />
                            <input type="hidden" name="isActive" value="@(employee.Status == "Active" ? "false" : "true")" />
                            <button type="submit" class="btn @(employee.Status == "Active" ? "btn-danger" : "btn-success")">
                                @(employee.Status == "Active" ? Localizer["Deactivate"] : Localizer["Activate"])
                            </button>
                        </form>
                    }
                    <a class="btn btn-info" asp-action="Details" asp-route-id="@employee.Id">@Localizer["Details"]</a>
                    @if (User.IsInRole("HRManager") || User.IsInRole("Administrator"))
                    {
                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@employee.Id">@Localizer["Edit"]</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center">
    @Html.PagedListPager(Model, page => Url.Action("Index", new {
    pageNumber = page,
        sortOrder = ViewBag.CurrentSort,
        searchString = ViewBag.CurrentFilter,
        selectedPositions = ((List<string>)ViewBag.SelectedPositions)?.ToArray(),
        showInactive = ViewBag.ShowInactive,
        }), new PagedListRenderOptions
            {
                Display = PagedListDisplayMode.IfNeeded,
                MaximumPageNumbersToDisplay = 5,
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                DisplayLinkToIndividualPages = true,
                EllipsesFormat = "…",
                LinkToFirstPageFormat = Localizer["PagerFirst"].Value,
                LinkToPreviousPageFormat = Localizer["PagerPrevious"].Value,
                LinkToNextPageFormat = Localizer["PagerNext"].Value,
                LinkToLastPageFormat = Localizer["PagerLast"].Value,
                ContainerDivClasses = new[] { "pagination-container" },
                UlElementClasses = new[] { "pagination", "justify-content-center" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
</div>