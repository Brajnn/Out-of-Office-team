@model Out_of_Office.Application.Employee.EmployeeDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EmployeeDetails"];
}

<h2>@Localizer["EmployeeDetails"]</h2>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">@Localizer["FullName"]</dt>
        <dd class="col-sm-10">@Model.FullName</dd>

        <dt class="col-sm-2">@Localizer["Username"]</dt>
        <dd class="col-sm-10">@Model.Username</dd>

        <dt class="col-sm-2">@Localizer["Subdivision"]</dt>
        <dd class="col-sm-10">@Model.Subdivision</dd>

        <dt class="col-sm-2">@Localizer["Position"]</dt>
        <dd class="col-sm-10">@Model.Position</dd>

        <dt class="col-sm-2">@Localizer["HireDate"]</dt>
        <dd class="col-sm-10">@Model.HireDate.ToShortDateString()</dd>

        <dt class="col-sm-2">@Localizer["Status"]</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">@Localizer["PeoplePartnerID"]</dt>
        <dd class="col-sm-10">@Model.PeoplePartnerID</dd>

        @if (Model.Photo != null && Model.Photo.Length > 0)
        {
            <dt class="col-sm-2">@Localizer["Photo"]</dt>
            <dd class="col-sm-10">
                <img src="data:image;base64,@Convert.ToBase64String(Model.Photo)" alt="@Localizer["EmployeePhotoAlt"]" style="max-width:200px;" />
            </dd>
        }
    </dl>
    <dt class="col-sm-2">@Localizer["LeaveBalances"]</dt>
    <dd class="col-sm-10">
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>@Localizer["LeaveType"]</th>
                    <th>@Localizer["DaysAvailable"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lb in Model.LeaveBalances)
                {
                    <tr>
                        <td>@lb.Type</td>
                        <td>@lb.DaysAvailable</td>
                    </tr>
                }
            </tbody>
        </table>
    </dd>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["BackToList"]</a>
</div>