@model Out_of_Office.Application.Employee.EmployeeDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EmployeeDetails"];
}

<h2>@Localizer["EmployeeDetails"]</h2>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">@Localizer["FullName"]</dt>
        <dd class="col-sm-10">@Model.FullName</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-2">@Localizer["Username"]</dt>
        <dd class="col-sm-10">@Model.Username</dd>

        <dt class="col-sm-2">@Localizer["Subdivision"]</dt>
        <dd class="col-sm-10">@Model.Subdivision</dd>

        <dt class="col-sm-2">@Localizer["Position"]</dt>
        <dd class="col-sm-10">@Localizer[$"Position_{Model.Position}"]</dd>

        <dt class="col-sm-2">@Localizer["HireDate"]</dt>
        <dd class="col-sm-10">@Model.HireDate.ToShortDateString()</dd>

        <dt class="col-sm-2">@Localizer["Status"]</dt>
        <dd class="col-sm-10">@Localizer[$"EmployeeStatus_{Model.Status}"]</dd>

        <dt class="col-sm-2">@Localizer["PeoplePartnerID"]</dt>
        <dd class="col-sm-10">@Model.PeoplePartnerID</dd>

        @if (Model.Photo != null && Model.Photo.Length > 0)
        {
            <dt class="col-sm-2">@Localizer["Photo"]</dt>
            <dd class="col-sm-10">
                <img src="data:image;base64,@Convert.ToBase64String(Model.Photo)" alt="@Localizer["EmployeePhotoAlt"]" style="max-width:200px;" />
            </dd>
        }
    </dl>
    <dt class="col-sm-2">@Localizer["LeaveBalances"]</dt>
    <dd class="col-sm-10">
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>@Localizer["LeaveType"]</th>
                    <th>@Localizer["DaysAvailable"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lb in Model.LeaveBalances)
                {
                    <tr>
                        <td>@Localizer[$"LeaveType_{lb.Type}"]</td>
                        <td>@lb.DaysAvailable</td>
                    </tr>
                }
            </tbody>
        </table>
    </dd>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["BackToList"]</a>
</div>
@if (User.IsInRole("Administrator"))
{
    <hr />
    <h4 class="mt-4">@Localizer["AdminActions"]</h4>

    <div class="row g-3">
        <!-- Reset hasła -->
        <div class="col-md-6">
            <form asp-controller="Account" asp-action="AdminSetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="employeeId" value="@Model.Id" />

                <div class="mb-2">
                    <label class="form-label">@Localizer["NewPassword"]</label>
                    <input type="password" name="newPassword" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Localizer["ConfirmNewPassword"]</label>
                    <input type="password" name="confirmPassword" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-outline-primary"
                        onclick="return confirm('@Localizer["ConfirmSetNewPassword"]');">
                    @Localizer["SetNewPasswordButton"]
                </button>
            </form>
        </div>

        <!-- Wyłącz 2FA -->
        @if (ViewBag.TargetHas2FA == true)
        {
            <div class="col-md-6">
                <form asp-controller="Account" asp-action="AdminDisableTwoFactor" method="post"
                      onsubmit="return confirm('@Localizer["ConfirmDisable2FA"]');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="employeeId" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-warning">
                        @Localizer["Disable2FAButton"]
                    </button>
                </form>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info mt-3">@TempData["InfoMessage"]</div>
    }
}
