@model Out_of_Office.Application.Models.AssignProjectViewModel.AssignProjectViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["AssignEmployeeToProject"];
}

<h2>@Localizer["AssignEmployeeToProject"]</h2>

<h4>@Localizer["ProjectLabel"] @Model.Project.ProjectType</h4>
<h4>@Localizer["ProjectIDLabel"] @Model.ProjectId</h4>

<form asp-action="AssignEmployee" method="post">
    <input type="hidden" asp-for="ProjectId" />
    <div class="form-group">
        <label for="EmployeeId">@Localizer["SelectEmployee"]</label>
        <select asp-for="EmployeeId" class="form-control" asp-items="@(new SelectList(Model.Employees, "Id", "FullName"))"></select>
    </div>
    <div class="form-group text-center">
        <button type="submit" class="btn btn-primary">@Localizer["Assign"]</button>
    </div>
</form>

<div>
    <a asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-secondary">@Localizer["BackToProjectDetails"]</a>
</div>