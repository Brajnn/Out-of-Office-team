@model Out_of_Office.Application.Project.ProjectDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["ProjectDetails"];
}

<h2>@Localizer["ProjectDetails"]</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Localizer["TableHeader_ID"]</dt>
        <dd class="col-sm-10">@Model.ID</dd>
        <dt class="col-sm-2">@Localizer["ProjectName"]</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">@Localizer["TableHeader_ProjectType"]</dt>
        <dd class="col-sm-10">@Model.ProjectType</dd>

        <dt class="col-sm-2">@Localizer["TableHeader_StartDate"]</dt>
        <dd class="col-sm-10">@Model.StartDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">@Localizer["TableHeader_EndDate"]</dt>
        <dd class="col-sm-10">@Model.EndDate?.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">@Localizer["TableHeader_ProjectManager"]</dt>
        <dd class="col-sm-10">@Model.ProjectManagerFullName</dd>

        <dt class="col-sm-2">@Localizer["Comment"]</dt>
        <dd class="col-sm-10">@Model.Comment</dd>

        <dt class="col-sm-2">@Localizer["Status"]</dt>
        <dd class="col-sm-10">@Localizer[$"ProjectStatus{Model.Status}"]</dd>
    </dl>
</div>
<h3>@Localizer["EmployeesInThisProject"]</h3>
<table class="table">
    <thead>
        <tr>
            <th>@Localizer["TableHeader_ID"]</th>
            <th>@Localizer["FullName"]</th>
            @if (User.IsInRole("ProjectManager") || User.IsInRole("Administrator"))
            {
                <th>@Localizer["Actions"]</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.FullName</td>
                <td>
                    <form asp-action="RemoveEmployee" method="post" class="d-inline">
                        <input type="hidden" name="EmployeeId" value="@employee.Id" />
                        <input type="hidden" name="ProjectId" value="@Model.ID" />
                        @if (User.IsInRole("ProjectManager"))
                        {
                            <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index" class="btn btn-primary">@Localizer["BackToList"]</a>
    @if (User.IsInRole("ProjectManager") || User.IsInRole("Administrator")
        && Model.Status == Out_of_Office.Domain.Entities.ProjectStatus.Active)
    {
        <a asp-action="AssignEmployee" asp-route-id="@Model.ID" class="btn btn-secondary">@Localizer["AssignEmployee"]</a>
    }
</div>