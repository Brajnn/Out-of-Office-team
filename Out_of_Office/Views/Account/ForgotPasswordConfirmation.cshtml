@{
    ViewData["Title"] = "Reset link sent";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="mb-3">Check your inbox</h3>
                <p class="text-muted mb-4">If an account with that email exists, we sent a reset link.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Go to login</a>
            </div>
        </div>
    </div>
</div>
