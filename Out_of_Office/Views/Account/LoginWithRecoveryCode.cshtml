@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Out_of_Office.Models.LoginWithRecoveryCodeViewModel

@{
    ViewData["Title"] = Localizer["LoginWithRecoveryCode_Title"];
}

<h2>@Localizer["LoginWithRecoveryCode_Header"]</h2>

<p class="text-muted">
    @Localizer["LoginWithRecoveryCode_Intro"]
</p>

<form asp-action="LoginWithRecoveryCode" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="RecoveryCode" class="form-label">@Localizer["RecoveryCode_Label"]</label>
        <input asp-for="RecoveryCode" class="form-control" autocomplete="one-time-code" />
        <span asp-validation-for="RecoveryCode" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        @Localizer["Login_Button"]
    </button>

    <a class="btn btn-link" asp-controller="Account" asp-action="LoginWith2fa">
        @Localizer["BackTo2FA_Link"]
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
