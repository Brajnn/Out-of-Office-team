@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Out_of_Office.Models.LoginWith2faViewModel
@{
    ViewData["Title"] = @Localizer["2faHeader"];
}
<h2>@Localizer["2faHeader"]</h2>

<form asp-action="LoginWith2fa" method="post">
    <div class="mb-3">
        <label class="form-label">@Localizer["AuthenticatorCode"]</label>
        <input asp-for="Code" class="form-control" autocomplete="off" required />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["LoginButton"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
