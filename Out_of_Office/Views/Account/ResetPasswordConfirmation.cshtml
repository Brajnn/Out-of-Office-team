@{
    ViewData["Title"] = "Password reset successful";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="mb-3">Password has been reset</h3>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Go to login</a>
            </div>
        </div>
    </div>
</div>
