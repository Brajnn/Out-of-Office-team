@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Out_of_Office.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="mb-3">@Localizer["Header"]</h3>
                <p class="text-muted">@Localizer["Instruction"]</p>

                <partial name="_Alerts" />

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">@Localizer["EmailLabel"]</label>
                        <input asp-for="Email" class="form-control" placeholder="@Localizer["EmailLabel"]" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            @Localizer["SubmitButton"]
                        </button>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                            @Localizer["BackToLogin"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
