@using Microsoft.AspNetCore.Mvc.Localization
@model Out_of_Office.Models.ForgotPasswordViewModel
@inject IViewLocalizer Localizer

<h2>@Localizer["Forgot Password"]</h2>

<form asp-action="ForgotPassword" method="post">
    <div class="mb-3">
        <label asp-for="Email" class="form-label">@Localizer["Email"]</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["Send reset link"]</button>
</form>
