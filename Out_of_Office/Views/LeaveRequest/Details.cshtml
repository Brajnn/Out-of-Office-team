@model Out_of_Office.Application.Leave_Request.LeaveRequestDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["LeaveRequestDetails"];
    string formattedReason = string.Concat(Model.AbsenceReason.Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()));
    int totalDays = (Model.EndDate - Model.StartDate).Days + 1;
}

<h2 class="mb-4">@Localizer["LeaveRequestDetails"]</h2>

<div class="card shadow p-4">
    <dl class="row">
        <dt class="col-sm-3">@Localizer["RequestID"]</dt>
        <dd class="col-sm-9">@Model.ID</dd>

        <dt class="col-sm-3">@Localizer["TableHeader_Employee"]</dt>
        <dd class="col-sm-9">@Model.EmployeeFullName</dd>

        <dt class="col-sm-3">@Localizer["AbsenceReason"]</dt>
        <dd class="col-sm-9">@Localizer[$"LeaveType_{Model.AbsenceReason}"]</dd>

        <dt class="col-sm-3">@Localizer["TableHeader_CreatedAt"]</dt>
        <dd class="col-sm-9">@Model.CreatedAt</dd>

        <dt class="col-sm-3">@Localizer["TableHeader_StartDate"]</dt>
        <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy")</dd>

        <dt class="col-sm-3">@Localizer["TableHeader_EndDate"]</dt>
        <dd class="col-sm-9">@Model.EndDate.ToString("dd MMM yyyy")</dd>

        <dt class="col-sm-3">@Localizer["TotalDaysIncludingHolidays"]</dt>
        <dd class="col-sm-9">@totalDays</dd>

        <dt class="col-sm-3">@Localizer["WorkingDaysExcludingHolidays"]</dt>
        <dd class="col-sm-9">@Model.WorkingDays</dd>

        <dt class="col-sm-3">@Localizer["Comment"]</dt>
        <dd class="col-sm-9">@Model.Comment</dd>

        <dt class="col-sm-3">@Localizer["Status"]</dt>
        <dd class="col-sm-9">@Localizer[$"Status{Model.Status}"]</dd>

        @if (Model.SubmittedAt != null)
        {
            <dt class="col-sm-3">@Localizer["SubmittedAt"]</dt>
            <dd class="col-sm-9">@Model.SubmittedAt?.ToString("dd MMM yyyy HH:mm")</dd>
        }

        @if (Model.StatusChangedAt != null)
        {
            <dt class="col-sm-3">@Localizer["DecisionDate"]</dt>
            <dd class="col-sm-9">@Model.StatusChangedAt?.ToString("dd MMM yyyy HH:mm")</dd>
        }

        @if (Model.DecisionComment != null)
        {
            <dt class="col-sm-3">@Localizer["DecisionComment"]</dt>
            <dd class="col-sm-9">@Model.DecisionComment</dd>
        }
    </dl>
</div>

<p class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">@Localizer["BackToListWithArrow"]</a>
</p>